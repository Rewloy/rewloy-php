{
    "name": "rewloy/rewloy-php",
    "description": "Rewloy API için resmî PHP kütüphanesi / The official PHP library for the Rewloy API",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "rewloy",
        "loyalty",
        "sadakat",
        "wallet",
        "apple-wallet",
        "google-wallet",
        "api",
        "sdk"
    ],
    "homepage": "https://github.com/Rewloy/rewloy-php",
    "authors": [
        {
            "name": "Rewloy",
            "homepage": "https://rewloy.com"
        }
    ],
    "support": {
        "issues": "https://github.com/Rewloy/rewloy-php/issues",
        "source": "https://github.com/Rewloy/rewloy-php",
        "docs": "https://rewloy.com/gelistiriciler",
        "security": "https://github.com/Rewloy/rewloy-php/security/policy"
    },
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-hash": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Rewloy\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rewloy\\Dev\\": "scripts/",
            "Rewloy\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "generate": "@php scripts/generate.php",
        "analyse": [
            "phpstan analyse --no-progress",
            "phpstan analyse --no-progress -c phpstan.live.neon"
        ],
        "test": "phpunit",
        "live": "phpunit -c phpunit.live.xml",
        "check": [
            "@analyse",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "generate": "Regenerate src/Generated/ from the live OpenAPI document (or --file openapi/openapi.json)",
        "analyse": "PHPStan at the configured level",
        "test": "PHPUnit (no network)",
        "live": "The live tests against a dev Rewloy (REWLOY_BASE_URL, REWLOY_API_KEY): tests/Live",
        "check": "PHPStan, then PHPUnit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
