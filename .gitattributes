# Kept out of what Composer downloads (the archive GitHub builds for a
# commit or tag): an install gets src/, composer.json and the top-level
# documents, not the 3.5 MB OpenAPI snapshot, the tests or the tooling.
/.github            export-ignore
/docs               export-ignore
/openapi            export-ignore
/scripts            export-ignore
/tests              export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/phpstan.neon.dist  export-ignore
/phpunit.xml.dist   export-ignore
